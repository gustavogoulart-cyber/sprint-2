<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VoltMotores | Control Center</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome Ícones -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>

<div class="wrapper">
  <!-- Sidebar de Navegação -->
  <nav id="sidebar">
    <div class="sidebar-header">
      <i class="fa-solid fa-bolt me-2"></i>VoltMotores
    </div>
    <ul class="list-unstyled components">
      <li class="active">
        <a href="/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
      </li>
      <li>
        <a href="/produtos"><i class="fa-solid fa-boxes-stacked"></i> Estoque & Relatórios</a>
      </li>
      <li>
        <a href="/categorias"><i class="fa-solid fa-tags"></i> Categorias</a>
      </li>
      <li>
        <a href="/usuarios"><i class="fa-solid fa-users"></i> Usuários</a>
      </li>
      <li class="mt-4">
        <a href="/" class="text-danger"><i class="fa-solid fa-right-from-bracket"></i> Sair do Sistema</a>
      </li>
    </ul>
  </nav>

  <!-- Conteúdo Principal -->
  <div id="content">
    <!-- Topbar Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h3 class="fw-bold m-0 text-dark">Painel Executivo de Estoque</h3>
        <p class="text-muted small m-0">Monitoramento e inteligência da frota elétrica</p>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span class="badge bg-success-subtle text-success p-2 px-3 rounded-pill fw-bold">
          <i class="fa-solid fa-circle me-1" style="font-size: 8px;"></i> Sistema Online
        </span>
      </div>
    </div>

    <!-- Indicadores Principais (KPIs) -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card kpi-card p-3 bg-white">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-muted small fw-bold text-uppercase">Valor Total em Estoque</span>
              <h3 class="fw-bold m-0 mt-1">R$ <%= valorTotalEstoque.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></h3>
            </div>
            <div class="icon-box bg-success-subtle text-success">
              <i class="fa-solid fa-sack-dollar"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card kpi-card p-3 bg-white">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-muted small fw-bold text-uppercase">Modelos Cadastrados</span>
              <h3 class="fw-bold m-0 mt-1"><%= totalProdutos %> modelos</h3>
            </div>
            <div class="icon-box bg-primary-subtle text-primary">
              <i class="fa-solid fa-motorcycle"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card kpi-card p-3 bg-white">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-muted small fw-bold text-uppercase">Alerta de Reposição</span>
              <h3 class="fw-bold text-danger m-0 mt-1"><%= produtosBaixoEstoque.length %> críticos</h3>
            </div>
            <div class="icon-box bg-danger-subtle text-danger">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção de Gráficos (Chart.js) -->
    <div class="row g-4 mb-4">
      <div class="col-lg-8">
        <div class="card card-table p-4 bg-white">
          <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-chart-column me-2"></i>Fluxo de Movimentações (Entradas vs Saídas)</h6>
          <canvas id="graficoBarras" height="110"></canvas>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="card card-table p-4 bg-white">
          <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-chart-pie me-2"></i>Estoque por Categoria</h6>
          <canvas id="graficoRosca" height="230"></canvas>
        </div>
      </div>
    </div>

    <!-- Alerta de Estoque Mínimo -->
    <% if (produtosBaixoEstoque.length > 0) { %>
      <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
        <h6 class="fw-bold"><i class="fa-solid fa-bell me-2"></i>Necessidade Urgente de Compra/Reposição:</h6>
        <ul class="mb-0 small">
          <% produtosBaixoEstoque.forEach(item => { %>
            <li><strong><%= item.nome %></strong> — Restam apenas <strong><%= item.estoqueAtual %> unidades</strong> (Estoque Mínimo Exigido: <%= item.estoqueMinimo %>)</li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Histórico de Movimentações -->
    <div class="card card-table bg-white">
      <div class="card-header bg-white py-3 border-0">
        <h6 class="fw-bold text-secondary m-0"><i class="fa-solid fa-clock-rotate-left me-2"></i>Últimas Operações Registradas</h6>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Data / Hora</th>
              <th>Produto ID</th>
              <th>Tipo</th>
              <th>Quantidade</th>
              <th>Estoque Resultante</th>
              <th>Observação</th>
            </tr>
          </thead>
          <tbody>
            <% ultimasMovimentacoes.forEach(mov => { %>
              <tr>
                <td><small class="text-muted"><%= mov.data %></small></td>
                <td><strong>#<%= mov.produtoId %></strong></td>
                <td>
                  <span class="badge rounded-pill <%= mov.tipo === 'entrada' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> px-3 py-2">
                    <%= mov.tipo.toUpperCase() %>
                  </span>
                </td>
                <td><strong><%= mov.quantidade %> un</strong></td>
                <td><span class="badge bg-light text-dark border"><%= mov.estoqueResultante %> un</span></td>
                <td><small class="text-secondary"><%= mov.descricao %></small></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Gráfico 1: Barras
  new Chart(document.getElementById('graficoBarras'), {
    type: 'bar',
    data: {
      labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'],
      datasets: [
        { label: 'Entradas', data: [12, 19, 3, 5, 2, 8], backgroundColor: '#00b894', borderRadius: 4 },
        { label: 'Saídas', data: [8, 11, 5, 8, 3, 7], backgroundColor: '#d63031', borderRadius: 4 }
      ]
    },
    options: { responsive: true }
  });

  // Gráfico 2: Rosca
  new Chart(document.getElementById('graficoRosca'), {
    type: 'doughnut',
    data: {
      labels: ['Scooters', 'Street/Urbana', 'Carga/Work'],
      datasets: [{
        data: [12, 3, 2],
        backgroundColor: ['#00b894', '#0984e3', '#fdcb6e']
      }]
    },
    options: { responsive: true }
  });
</script>
</body>
</html>