<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VoltMotores | Mobilidade Elétrica</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-success" href="#"><i class="fa-solid fa-bolt me-1"></i> VoltMotores</a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="#empresa">Sobre Nós</a>
        <a class="nav-link" href="#produtos">Modelos</a>
        <a class="btn btn-outline-success ms-3 fw-bold" href="/login"><i class="fa-solid fa-lock me-1"></i> Área Restrita</a>
      </div>
    </div>
  </nav>

  <!-- Banner Hero -->
  <section class="bg-dark text-white text-center py-5" style="background: linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.75)), url('https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1200&q=80') center/cover;">
    <div class="container py-5">
      <h1 class="display-4 fw-bold text-success mb-3">Mobilidade Inteligente e Zero Emissões</h1>
      <p class="lead text-light mb-4">A maior linha de motinhas e scooters elétricas para a sua rotina e frota corporativa.</p>
      <a href="#produtos" class="btn btn-success btn-lg fw-bold px-4"><i class="fa-solid fa-motorcycle me-2"></i> Conheça os Modelos</a>
    </div>
  </section>

  <!-- Seção Institucional -->
  <section id="empresa" class="py-5 bg-white">
    <div class="container">
      <div class="row text-center g-4">
        <div class="col-md-4">
          <div class="p-4 border rounded-4 shadow-sm h-100">
            <i class="fa-solid fa-leaf fa-3x text-success mb-3"></i>
            <h5 class="fw-bold">Missão</h5>
            <p class="text-muted small">Transformar o transporte urbano em uma experiência limpa, sustentável e acessível.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4 border rounded-4 shadow-sm h-100">
            <i class="fa-solid fa-rocket fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Visão</h5>
            <p class="text-muted small">Ser a marca líder de referência nacional no segmento de veículos elétricos de duas rodas.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4 border rounded-4 shadow-sm h-100">
            <i class="fa-solid fa-shield-halved fa-3x text-warning mb-3"></i>
            <h5 class="fw-bold">Valores</h5>
            <p class="text-muted small">Inovação tecnológica, responsabilidade ambiental, transparência e excelência no atendimento.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vitrine de Produtos -->
  <section id="produtos" class="py-5 bg-light">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0">Nossa Linha de Motinhas</h3>

        <!-- Filtro por Categoria -->
        <form method="GET" action="/" class="d-flex align-items-center gap-2">
          <label class="fw-bold text-nowrap small text-muted">Filtrar por:</label>
          <select name="categoria" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Todas as Categorias</option>
            <% categorias.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= (typeof categoriaSelecionada !== 'undefined' && categoriaSelecionada == cat.id) ? 'selected' : '' %>><%= cat.nome %></option>
            <% }) %>
          </select>
        </form>
      </div>

      <div class="row g-4">
        <% produtos.forEach(p => { %>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
              <img src="<%= p.imagem %>" class="card-img-top" alt="<%= p.nome %>" style="height: 220px; object-fit: cover;">
              <div class="card-body d-flex flex-column">
                <span class="badge bg-success-subtle text-success w-auto align-self-start mb-2 px-3 py-2"><%= p.categoriaNome %></span>
                <h5 class="card-title fw-bold"><%= p.nome %></h5>
                <p class="card-text text-muted small"><%= p.descricao %></p>
                <div class="my-3 text-secondary small">
                  <div><i class="fa-solid fa-battery-full text-success me-2"></i> Autonomia: <strong><%= p.autonomia %></strong></div>
                  <div><i class="fa-solid fa-gauge-high text-primary me-2"></i> Vel. Máxima: <strong><%= p.velocidadeMaxima %></strong></div>
                </div>
                <h4 class="fw-bold text-dark mt-auto m-0">R$ <%= p.preco.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></h4>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

</body>
</html>