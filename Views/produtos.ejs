<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Estoque & Relatórios | VoltMotores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="brand"><i class="fa-solid fa-bolt me-2"></i>VoltMotores</div>
      <nav class="nav flex-column mt-3">
        <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
        <a class="nav-link active" href="/produtos"><i class="fa-solid fa-boxes-stacked"></i> Gestão de Estoque</a>
        <a class="nav-link" href="/categorias"><i class="fa-solid fa-tags"></i> Categorias</a>
        <a class="nav-link" href="/usuarios"><i class="fa-solid fa-users"></i> Usuários</a>
        <a class="nav-link text-danger mt-auto mb-3" href="/"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </nav>
    </aside>

    <main class="main-content">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h3 class="fw-bold m-0">Gestão de Estoque e Relatórios</h3>
          <p class="text-muted small m-0">Consulte o saldo de produtos, cadastre, edite itens e registre movimentações</p>
        </div>
      </div>

      <% if (typeof produtoEdicao !== 'undefined' && produtoEdicao) { %>
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 border-start border-4 border-primary">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-primary mb-0">
              <i class="fa-solid fa-pen-to-square me-2"></i>Editando: <%= produtoEdicao.nome %> (#<%= produtoEdicao.id %>)
            </h6>
            <a href="/produtos" class="btn btn-sm btn-outline-secondary">Cancelar</a>
          </div>

          <form action="/produtos/editar/<%= produtoEdicao.id %>" method="POST" class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold">Nome do Modelo</label>
              <input type="text" name="nome" class="form-control" value="<%= produtoEdicao.nome %>" required>
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-bold">Categoria</label>
              <select name="categoria_id" class="form-select" required>
                <% (typeof categorias !== 'undefined' ? categorias : []).forEach(c => { %>
                  <option value="<%= c.id %>" <%= Number(produtoEdicao.categoriaId) === Number(c.id) ? 'selected' : '' %>>
                    <%= c.nome %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-2">
              <label class="form-label small fw-bold">Preço (R$)</label>
              <input type="number" step="0.01" name="preco" class="form-control" value="<%= produtoEdicao.preco %>" required>
            </div>

            <div class="col-md-1">
              <label class="form-label small fw-bold">Estoque</label>
              <input type="number" name="estoque_atual" class="form-control" value="<%= produtoEdicao.estoqueAtual %>" required>
            </div>

            <div class="col-md-2">
              <label class="form-label small fw-bold">Estoque Mín.</label>
              <input type="number" name="estoque_minimo" class="form-control" value="<%= produtoEdicao.estoqueMinimo %>" required>
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-bold">Autonomia</label>
              <input type="text" name="autonomia" class="form-control" value="<%= produtoEdicao.autonomia || '' %>">
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-bold">Velocidade Máx.</label>
              <input type="text" name="velocidade_maxima" class="form-control" value="<%= produtoEdicao.velocidadeMaxima || '' %>">
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-bold">Descrição</label>
              <input type="text" name="descricao" class="form-control" value="<%= produtoEdicao.descricao || '' %>">
            </div>

            <div class="col-12 text-end">
              <button type="submit" class="btn btn-primary fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Alterações
              </button>
            </div>
          </form>
        </div>
      <% } %>

      <!-- Cadastrar Nova Motinha -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-plus-circle me-2"></i>Cadastrar Nova Motinha</h6>
        <form action="/produtos" method="POST" class="row g-3">
          <div class="col-md-4">
            <label class="form-label small fw-bold">Nome do Modelo</label>
            <input type="text" name="nome" class="form-control" required placeholder="Ex: Scooter Volt Pro 2000W">
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-bold">Categoria</label>
            <select name="categoria_id" class="form-select" required>
              <% (typeof categorias !== 'undefined' ? categorias : []).forEach(c => { %>
                <option value="<%= c.id %>"><%= c.nome %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label small fw-bold">Preço (R$)</label>
            <input type="number" step="0.01" name="preco" class="form-control" required placeholder="8500.00">
          </div>

          <div class="col-md-1">
            <label class="form-label small fw-bold">Estoque</label>
            <input type="number" name="estoque_atual" class="form-control" min="0" required placeholder="0">
          </div>

          <div class="col-md-2">
            <label class="form-label small fw-bold">Estoque Mín.</label>
            <input type="number" name="estoque_minimo" class="form-control" min="0" required placeholder="3">
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-bold">Autonomia</label>
            <input type="text" name="autonomia" class="form-control" placeholder="Ex: 60 km">
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-bold">Velocidade Máx.</label>
            <input type="text" name="velocidade_maxima" class="form-control" placeholder="Ex: 55 km/h">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Descrição</label>
            <input type="text" name="descricao" class="form-control" placeholder="Detalhes do modelo elétrico">
          </div>

          <div class="col-12 text-end">
            <button type="submit" class="btn btn-success fw-bold">
              <i class="fa-solid fa-plus me-1"></i> Cadastrar Produto
            </button>
          </div>
        </form>
      </div>

      <!-- Formulário de Movimentação de Estoque -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-right-left me-2"></i>Registrar Nova Entrada / Saída</h6>
        <form action="/produtos/movimentar" method="POST" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label small fw-bold">Produto</label>
            <select name="produtoId" class="form-select" required>
              <% produtos.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.nome %> (Atual: <%= p.estoqueAtual %> un)</option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label small fw-bold">Operação</label>
            <select name="tipo" class="form-select" required>
              <option value="entrada">Entrada (Compra)</option>
              <option value="saida">Saída (Venda / Uso)</option>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label small fw-bold">Quantidade</label>
            <input type="number" name="quantidade" class="form-control" min="1" required placeholder="Qtd">
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-bold">Observação / Descrição</label>
            <input type="text" name="descricao" class="form-control" required placeholder="Ex: Pedido #1020">
          </div>

          <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100 fw-bold"><i class="fa-solid fa-check me-1"></i> Confirmar</button>
          </div>
        </form>
      </div>

      <!-- Relatório de Produtos com Filtro -->
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h6 class="fw-bold text-secondary mb-0"><i class="fa-solid fa-list me-2"></i>Relatório Geral de Motinhas</h6>

          <form method="GET" action="/produtos" class="d-flex gap-2">
            <input type="text" name="busca" class="form-control form-control-sm" placeholder="Buscar por nome..." value="<%= typeof busca !== 'undefined' ? busca : '' %>">
            <select name="ordenacao" class="form-select form-select-sm">
              <option value="">Ordenar por...</option>
              <option value="preco-asc" <%= (typeof ordenacao !== 'undefined' && ordenacao === 'preco-asc') ? 'selected' : '' %>>Menor Preço</option>
              <option value="estoque-desc" <%= (typeof ordenacao !== 'undefined' && ordenacao === 'estoque-desc') ? 'selected' : '' %>>Maior Estoque</option>
              <option value="baixo-estoque" <%= (typeof ordenacao !== 'undefined' && ordenacao === 'baixo-estoque') ? 'selected' : '' %>>Abaixo do Mínimo</option>
            </select>
            <button type="submit" class="btn btn-sm btn-dark">Filtrar</button>
          </form>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Modelo</th>
                <th>Categoria</th>
                <th>Preço Un.</th>
                <th>Estoque Atual</th>
                <th>Estoque Mín.</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% produtos.forEach(p => { %>
                <tr>
                  <td>#<%= p.id %></td>
                  <td><strong><%= p.nome %></strong></td>
                  <td><span class="badge bg-light text-dark border"><%= p.categoriaNome %></span></td>
                  <td>R$ <%= Number(p.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td><strong><%= p.estoqueAtual %> un</strong></td>
                  <td><%= p.estoqueMinimo %> un</td>
                  <td>
                    <% if (Number(p.estoqueAtual) <= Number(p.estoqueMinimo)) { %>
                      <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Repor</span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-circle-check me-1"></i>OK</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/produtos/editar/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-pen"></i> Editar
                      </a>
                      <form action="/produtos/excluir/<%= p.id %>" method="POST" onsubmit="return confirm('Deseja realmente excluir este produto?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="fa-solid fa-trash"></i> Excluir
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

</body>
</html>