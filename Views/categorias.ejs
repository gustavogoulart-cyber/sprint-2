<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorias | VoltMotores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="brand"><i class="fa-solid fa-bolt me-2"></i>VoltMotores</div>
      <nav class="nav flex-column mt-3">
        <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
        <a class="nav-link" href="/produtos"><i class="fa-solid fa-boxes-stacked"></i> Gestão de Estoque</a>
        <a class="nav-link active" href="/categorias"><i class="fa-solid fa-tags"></i> Categorias</a>
        <a class="nav-link" href="/usuarios"><i class="fa-solid fa-users"></i> Usuários</a>
        <a class="nav-link text-danger mt-auto mb-3" href="/"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </nav>
    </aside>

    <main class="main-content">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold m-0">Categorias de Motinhas</h3>
          <p class="text-muted small m-0">Classificação dos modelos elétricos no catálogo</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-success fw-bold">
          <i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Dashboard
        </a>
      </div>

      <% if (typeof categoriaEdicao !== 'undefined' && categoriaEdicao) { %>
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-success mb-0">
              <i class="fa-solid fa-pen-to-square me-2"></i>Editando Categoria: <%= categoriaEdicao.nome %> (#<%= categoriaEdicao.id %>)
            </h6>
            <a href="/categorias" class="btn btn-sm btn-outline-secondary">Cancelar</a>
          </div>

          <form action="/categorias/editar/<%= categoriaEdicao.id %>" method="POST" class="row g-3">
            <div class="col-md-4">
              <label for="nome" class="form-label small fw-bold">Nome da Categoria</label>
              <input id="nome" type="text" name="nome" class="form-control" value="<%= categoriaEdicao.nome %>" required>
            </div>

            <div class="col-md-8">
              <label for="descricao" class="form-label small fw-bold">Descrição</label>
              <input id="descricao" type="text" name="descricao" class="form-control" value="<%= categoriaEdicao.descricao || '' %>">
            </div>

            <div class="col-12 text-end">
              <button type="submit" class="btn btn-success fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Alterações
              </button>
            </div>
          </form>
        </div>
      <% } %>

      <!-- Cadastrar Nova Categoria -->
      <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
        <h6 class="fw-bold text-success mb-3">
          <i class="fa-solid fa-folder-plus me-2"></i>Cadastrar Nova Categoria
        </h6>

        <form action="/categorias" method="POST" class="row g-3 align-items-end">
          <div class="col-md-4">
            <label for="nova_nome" class="form-label small fw-bold">Nome da Categoria</label>
            <input id="nova_nome" type="text" name="nome" class="form-control" required placeholder="Ex: Scooter Elétrica">
          </div>

          <div class="col-md-6">
            <label for="nova_descricao" class="form-label small fw-bold">Descrição</label>
            <input id="nova_descricao" type="text" name="descricao" class="form-control" placeholder="Ex: Modelos compactos para uso urbano">
          </div>

          <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100 fw-bold">
              <i class="fa-solid fa-plus me-1"></i> Cadastrar
            </button>
          </div>
        </form>
      </div>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% const lista = typeof categorias !== 'undefined' && Array.isArray(categorias) ? categorias : []; %>
              <% if (lista.length === 0) { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">Nenhuma categoria cadastrada no momento.</td>
                </tr>
              <% } else { %>
                <% lista.forEach(c => { %>
                  <tr>
                    <td>#<%= c.id %></td>
                    <td><strong><%= c.nome %></strong></td>
                    <td><%= c.descricao || 'Sem descrição' %></td>
                    <td>
                      <div class="d-flex gap-1">
                        <a href="/categorias/editar/<%= c.id %>" class="btn btn-sm btn-outline-success">
                          <i class="fa-solid fa-pen"></i> Editar
                        </a>
                        <form action="/categorias/excluir/<%= c.id %>" method="POST" onsubmit="return confirm('Deseja realmente excluir esta categoria?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-trash"></i> Excluir
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

</body>
</html>